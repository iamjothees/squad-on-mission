# ==========================================
# DOCKER & CLOUDFLARE CONFIGURATION
# ==========================================
# Cloudflare Tunnel Token for securely exposing the application
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Database Secrets (used by both Docker to init the DB, and Laravel to connect)
DB_ROOT_PASSWORD=your_secure_root_password
DB_DATABASE=som
DB_USERNAME=som
DB_PASSWORD=your_secure_database_password

# ==========================================
# LARAVEL APPLICATION CONFIGURATION
# ==========================================
APP_NAME="Squad on Mission"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Connection (Host matches the docker-compose service name)
DB_CONNECTION=mysql
DB_HOST=som-db
DB_PORT=3306
# Note: DB_DATABASE, DB_USERNAME, and DB_PASSWORD are provided in the Docker section above.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb WebSocket Configuration
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="your-domain.com"
REVERB_PORT=443
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
WORK_HOURS_PER_DAY=8
