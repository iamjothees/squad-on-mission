FROM iamjothees/laravel-image:php8.5

# Setup Node.js
ENV NVM_DIR="/usr/local/nvm"
RUN source $NVM_DIR/nvm.sh \
    && nvm install 22 \
    && nvm alias default 22 \
    && nvm use default

ENV PATH="/usr/local/nvm/versions/node/v22.23.2/bin:${PATH}"

# Set working directory
WORKDIR /var/www/html

# Copy application files into the image
COPY ./app /var/www/html

# Accept frontend build arguments
ARG VITE_APP_NAME="Manager Mangalam"
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME="https"

# Expose them to Vite during the build
ENV VITE_APP_NAME=$VITE_APP_NAME
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY
ENV VITE_REVERB_HOST=$VITE_REVERB_HOST
ENV VITE_REVERB_PORT=$VITE_REVERB_PORT
ENV VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME

# Install PHP dependencies (production optimized)
RUN composer install --no-dev --optimize-autoloader

# Install Node dependencies and build assets
RUN source /usr/local/nvm/nvm.sh && nvm use 22 && npm install && npm run build

# Set correct permissions for Laravel
RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache || true

# Copy and setup the startup script
COPY ./start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 80
EXPOSE 8080

CMD ["/start.sh"]
